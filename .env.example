# Copy to .env and adjust. Never commit a real .env file.
# Every variable is optional: the defaults run the whole platform in local/mock mode.

DOCINTEL_APP_ENV=local
DOCINTEL_LOG_LEVEL=INFO
DOCINTEL_LOG_JSON=true
# DOCINTEL_DATA_DIR=./data
# DOCINTEL_DATABASE_URL=sqlite:///./data/docintel.db

# ---- Providers: mock | bedrock | azure_openai --------------------------------
DOCINTEL_LLM_PROVIDER=mock
# hashing | bedrock | azure_openai
DOCINTEL_EMBEDDING_PROVIDER=hashing
# chroma | memory
DOCINTEL_VECTOR_STORE=chroma
# auto | tesseract | textract | none
DOCINTEL_OCR_PROVIDER=auto
# memory | otel
DOCINTEL_METRICS_BACKEND=memory

DOCINTEL_LLM_TEMPERATURE=0.0
DOCINTEL_LLM_MAX_TOKENS=1024
DOCINTEL_LLM_TIMEOUT_S=60
DOCINTEL_LLM_MAX_RETRIES=2

# ---- AWS Bedrock (credentials come from the standard AWS chain: env, profile, IAM role) --
DOCINTEL_AWS_REGION=us-east-1
# Newer Claude models are invoked through a cross-region inference profile (us./eu./global. prefix).
DOCINTEL_BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
DOCINTEL_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# A named AWS profile must be exported in the shell (export AWS_PROFILE=docintel); boto3 does
# not read it from this file. With `aws configure` (default profile) nothing extra is needed.

# ---- Azure OpenAI --------------------------------------------------------------
# DOCINTEL_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# DOCINTEL_AZURE_OPENAI_API_KEY=
# DOCINTEL_AZURE_OPENAI_API_VERSION=2024-10-21
# DOCINTEL_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
# DOCINTEL_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Reasoning deployments (GPT-5, o-series): omits temperature/seed, sends reasoning_effort and a
# larger max_completion_tokens budget. Requires API version 2024-12-01-preview or newer.
# DOCINTEL_AZURE_OPENAI_REASONING_MODEL=false
# DOCINTEL_AZURE_OPENAI_REASONING_EFFORT=low
# DOCINTEL_AZURE_OPENAI_REASONING_MAX_TOKENS=8192

# ---- Chunking / retrieval ------------------------------------------------------
DOCINTEL_CHUNK_SIZE=600
DOCINTEL_CHUNK_OVERLAP=80
DOCINTEL_RETRIEVAL_TOP_K=4
DOCINTEL_RETRIEVAL_MIN_SCORE=0.12

# ---- Human-review thresholds ---------------------------------------------------
DOCINTEL_CLASSIFICATION_MIN_CONFIDENCE=0.70
DOCINTEL_EXTRACTION_MIN_CONFIDENCE=0.60
DOCINTEL_ANSWER_MIN_CONFIDENCE=0.55
DOCINTEL_GROUNDEDNESS_MIN=0.80

# ---- Security ------------------------------------------------------------------
DOCINTEL_MAX_UPLOAD_MB=20
DOCINTEL_AUTH_ENABLED=false
# JSON map of API key -> role (viewer < analyst < reviewer < admin). Use a secrets manager in production.
# DOCINTEL_API_KEYS_JSON={"change-me-viewer":"viewer","change-me-reviewer":"reviewer"}
